# Application Settings
APP_NAME="FastAPI SMTP Proxy"
APP_VERSION="1.0.0"
DEBUG=false

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# Encryption Settings
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-generate-with-command-above

# Database
DATABASE_URL=sqlite+aiosqlite:///./smtp_proxy.db

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list of allowed origins)
# Example: CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:8000,https://localhost:8000

# Force HTTPS (for reverse proxy deployments)
# Set to true when running behind a reverse proxy that handles SSL/TLS termination
FORCE_HTTPS=false
